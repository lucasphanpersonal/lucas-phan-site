---
import PlainLayout from '../../layouts/PlainLayout.astro';
import { render } from 'astro:content';
import { getProjects, formatDate, url, isExternal, type Project } from '../../data/util';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects
    .filter((p) => p.data.status !== 'empty')
    .map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}
const { project } = Astro.props as { project: Project };
const { Content } = await render(project);
const d = project.data;
---
<PlainLayout title={d.title} description={d.description}>
  <p><a href={url('/projects/')}>← All projects</a></p>
  <h1>{d.title}</h1>
  <p>{d.description}</p>
  <dl class="facts">
    {d.date && (<><dt>Date</dt><dd><time datetime={d.date.toISOString()}>{formatDate(d.date)}</time></dd></>)}
    <dt>Status</dt><dd>{d.status === 'wip' ? 'In progress' : 'Released'}</dd>
    {d.tech.length > 0 && (<><dt>Tech</dt><dd>{d.tech.join(', ')}</dd></>)}
  </dl>
  {d.links.length > 0 && (
    <>
      <h2>Links</h2>
      <ul>
        {d.links.map((l) => (
          <li><a href={l.url} rel={isExternal(l.url) ? 'noopener' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </>
  )}
  <h2>About this project</h2>
  <Content />
</PlainLayout>
