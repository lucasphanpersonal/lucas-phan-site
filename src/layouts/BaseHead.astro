---
import { url } from '../data/util';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'Lucas Phan: developer. Power on the handheld to browse projects, or read the plain version.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('/og.png'), Astro.site);
const ogImageAlt = 'Pixel-art handheld console showing the status screen for Lucas Phan';
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
<meta name="theme-color" content="#1b1e3a" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Lucas Phan" />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />
